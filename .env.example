# LLM provider: anthropic | openai | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# Blocco 1 - microservizio analitico
# Docker Compose: stub interno http://block1-stub:7000 (o URL di un Blocco 1 reale)
# Avvio locale senza Docker: http://localhost:7000 (python dev/block1_stub.py)
BLOCK1_BASE_URL=http://block1-stub:7000
BLOCK1_API_KEY=

# App (in Docker la porta interna è sempre 5000; ORCHESTRATOR_PORT è la porta host)
APP_HOST=0.0.0.0
APP_PORT=5000
APP_LOG_LEVEL=INFO
ORCHESTRATOR_PORT=5000

MAX_TOOL_TURNS=5
